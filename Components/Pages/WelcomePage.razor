@page "/"

<div class="welcome-container">
    <h1>Welcome to DriveDrop!</h1>
    <p>Upload and collect wedding photos easily with a simple QR code.</p>

</div>

<section class="steps">
    <div class="steps-grid">

        @* Step 1 *@
        <div class="step-card">
            <div class="step-header">
                <span class="step-number">1</span>
                <div class="step-icon">
                    <i class="fa-solid fa-calendar"></i>
                </div>
            </div>

            <h3>Create Your Event</h3>
            <p>Name your event and generate a private upload link or QR code instantly</p>
        </div>

        @* Step 2 *@
        <div class="step-card">
            <div class="step-header">
                <span class="step-number">2</span>
                <div class="step-icon">
                    <i class="fa-solid fa-qrcode"></i>
                </div>
            </div>

            <h3>Share the QR Code</h3>
            <p>Guests scan the code and access your event upload page.</p>
        </div>

       @*  Step 3 *@
        <div class="step-card">
            <div class="step-header">
                <span class="step-number">3</span>
                <div class="step-icon">
                    <i class="fa-solid fa-cloud-arrow-up"></i>
                </div>
            </div>

            <h3>Collect the Photos</h3>
            <p>Photos upload directly to your Google Drive folder.</p>
        </div>

    </div>
</section>

