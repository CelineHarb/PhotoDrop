@page "/"

<div class="welcome-container">

    <div class="welcome-content">
        <div class="logo-mark">
            <DropletLogo Width="48" Height="60" />
        </div>
        <h1 class="title">PhotoDrop</h1>
        <p class="subtitle">Every moment, collected beautifully.</p>
        <a href="/get-started" class="btn-cta">Create your event</a>
    </div>
</div>

<section class="steps">
    <div class="steps-grid">
        <div class="step-card">
            <div class="step-header">
                <span class="step-number">1</span>
                <div class="step-icon">
                    <i class="fa-solid fa-calendar"></i>
                </div>
            </div>
            <h3>Create Your Event</h3>
            <p>Name your event, connect to your Google Drive, and generate a QR code.</p>
        </div>
        <div class="step-card">
            <div class="step-header">
                <span class="step-number">2</span>
                <div class="step-icon">
                    <i class="fa-solid fa-qrcode"></i>
                </div>
            </div>
            <h3>Share the QR Code</h3>
            <p>Guests scan the code and access your event upload page.</p>
        </div>
        <div class="step-card">
            <div class="step-header">
                <span class="step-number">3</span>
                <div class="step-icon">
                    <i class="fa-solid fa-cloud-arrow-up"></i>
                </div>
            </div>
            <h3>Collect the Photos</h3>
            <p>Photos upload directly to your Google Drive folder.</p>
        </div>
    </div>
</section>

@* Statement divider *@
<section class="statement-section">
    <p class="statement-text">
        No apps to download. No accounts to create.<br>
        <span class="statement-highlight">Just photos, collected.</span>
    </p>
</section>

@* Highlights with numbers *@
<section class="highlights-section">
    <div class="highlight-stat">
        <p class="stat-number">0s</p>
        <p class="stat-title">Setup time for guests</p>
        <p class="stat-desc">No downloads or signups</p>
    </div>
    <div class="highlight-stat">
        <p class="stat-number">1x</p>
        <p class="stat-title">Scan to upload</p>
        <p class="stat-desc">One QR code does it all</p>
    </div>
    <div class="highlight-stat">
        <p class="stat-number stat-number-coral">∞</p>
        <p class="stat-title">Guest Uploads</p>
        <p class="stat-desc">No cap per event - just your Drive space</p>
    </div>
</section>

<footer class="welcome-footer">
    <div class="footer-content">
        <div class="footer-logo">
            <DropletLogo Width="28" Height="35" />
            <span class="footer-brand">PhotoDrop</span>
        </div>
        <p class="footer-tagline">Collect every angle of every moment.</p>
        <a href="/get-started" class="btn-footer-cta">Start collecting photos</a>
        <p class="footer-copy">Built with care for the moments that matter.</p>
    </div>
</footer>


