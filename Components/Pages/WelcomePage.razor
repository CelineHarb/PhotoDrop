@page "/"

<div class="welcome-container">
    <div class="content">
        <h1>PhotoDrop</h1>
    </div>
</div>
<section class="steps">
    <div class="steps-grid">

        @* Step 1 *@
        <div class="step-card">
            <div class="step-header">
                <span class="step-number">1</span>
                <div class="step-icon">
                    <i class="fa-solid fa-calendar"></i>
                </div>
            </div>

            <h3>Create Your Event</h3>
            <p>Name your event, connect to your google drive, and generate a QR code</p>
        </div>

        @* Step 2 *@
        <div class="step-card">
            <div class="step-header">
                <span class="step-number">2</span>
                <div class="step-icon">
                    <i class="fa-solid fa-qrcode"></i>
                </div>
            </div>

            <h3>Share the QR Code</h3>
            <p>Guests scan the code and access your event upload page.</p>
        </div>

        @*  Step 3 *@
        <div class="step-card">
            <div class="step-header">
                <span class="step-number">3</span>
                <div class="step-icon">
                    <i class="fa-solid fa-cloud-arrow-up"></i>
                </div>
            </div>

            <h3>Collect the Photos</h3>
            <p>Photos upload directly to your Google Drive folder.</p>
        </div>

    </div>

    <div class="cta-wrapper">
        <a href="#" class="btn-get-started">
            Get Started
        </a>
    </div>
</section>

<div class="highlights">
    <span class="highlight">
        <i class="fa-solid fa-image"></i>
        Photos Only
    </span>

    <span class="highlight">
        <i class="fa-solid fa-user-check"></i>
        No Guest Login
    </span>

    <span class="highlight">
        <i class="fa-solid fa-google-drive"></i>
        Uploads to you Google Drive
    </span>
</div>



