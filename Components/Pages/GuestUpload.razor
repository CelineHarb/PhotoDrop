@page "/e/{Token}"
@inject PhotoDrop.Services.EventStorage EventStorage
@inject HttpClient Http
@inject IJSRuntime JS
@using PhotoDrop.Models

<div class="guest-page-container">
    @if (eventRecord is null)
    {
        <div class="guest-card">
            <DropletLogo Width="32" Height="40" />
            <h1 class="guest-title">Event not found</h1>
            <p class="guest-text">This upload link may be invalid or expired.</p>
        </div>
    }
    else
    {
        <div class="guest-card">
            <DropletLogo Width="48" Height="60" />
            <h1 class="guest-title">@eventRecord.EventName</h1>

            @if (eventFull)
            {
                <p class="guest-text">This event's photo collection is full. Thanks for sharing!</p>
            }
            else
            {
                @if (sessionLoaded)
                {
                    <p class="guest-text">You can upload up to @remainingSlots more photos</p>
                }
                else
                {
                    <p class="guest-text">Loading...</p>
                }

                @if (!uploadComplete && remainingSlots > 0 && sessionLoaded)
                {
                    <label class="drop-zone">
                        <InputFile OnChange="HandleFilesSelected"
                                   multiple
                                   accept=".jpg,.jpeg,.png,.heic,.heif,.webp"
                                   @ref="inputFileRef" />
                        <div class="drop-zone-circle">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                                <path d="M12 5v14M5 12h14" stroke="#C4A882" stroke-width="1.5" stroke-linecap="round" />
                            </svg>
                        </div>
                        <span class="drop-zone-text">Tap to select photos</span>
                    </label>
                }

                @if (previews.Count > 0 && !uploadComplete)
                {
                    <div class="preview-grid">
                        @foreach (var photo in previews)
                        {
                            <div class="preview-item">
                                <img src="@photo.PreviewUrl" alt="@photo.Name" class="preview-image" />

                                @if (photo.Status == "uploading")
                                {
                                    <div class="preview-overlay">
                                        <div class="preview-spinner"></div>
                                    </div>
                                }
                                else if (photo.Status == "done")
                                {
                                    <div class="preview-check">
                                        <svg width="14" height="14" viewBox="0 0 16 16">
                                            <path d="M3 8l4 4 6-7" stroke="white" stroke-width="2" fill="none" stroke-linecap="round" />
                                        </svg>
                                    </div>
                                }
                                else if (photo.Status == "failed")
                                {
                                    <div class="preview-failed">
                                        <svg width="14" height="14" viewBox="0 0 16 16">
                                            <path d="M4 4l8 8M12 4l-8 8" stroke="white" stroke-width="2" fill="none" stroke-linecap="round" />
                                        </svg>
                                    </div>
                                }
                                else
                                {
                                    <button class="preview-remove" @onclick="() => RemovePhoto(photo)">
                                        <svg width="10" height="10" viewBox="0 0 16 16">
                                            <path d="M4 4l8 8M12 4l-8 8" stroke="white" stroke-width="2" fill="none" stroke-linecap="round" />
                                        </svg>
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    @if (!isUploading)
                    {
                        <button type="button" class="upload-btn" @onclick="UploadFiles">
                            Upload @previews.Count photo@(previews.Count == 1 ? "" : "s")
                        </button>
                        @if (remainingSlots > 0)
                        {
                            <p class="remaining-text">@remainingSlots more photo(s) allowed</p>
                        }
                    }
                    else
                    {
                        <div class="progress-bar-track">
                            <div class="progress-bar-fill" style="width: @ProgressPercent%"></div>
                        </div>
                        <p class="upload-progress-text">Uploading @uploadedCount of @previews.Count...</p>
                    }
                }

                @if (uploadComplete)
                {
                    <div class="upload-done">
                        <div class="done-icon">
                            <svg width="32" height="32" viewBox="0 0 16 16">
                                <path d="M3 8l4 4 6-7" stroke="#C4A882" stroke-width="1.5" fill="none" stroke-linecap="round" />
                            </svg>
                        </div>
                        <p class="done-title">@uploadedCount photo@(uploadedCount == 1 ? "" : "s") uploaded!</p>
                        @if (failedCount > 0)
                        {
                            <p class="done-failed">@failedCount failed</p>
                        }
                        @if (remainingSlots > 0)
                        {
                            <button type="button" class="upload-more-btn" @onclick="Reset">
                                Upload more photos
                            </button>
                        }
                        else
                        {
                            <p class="done-title">You've reached your photo limit.</p>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(statusMessage))
                {
                    <p class="status-message @statusClass">@statusMessage</p>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public string Token { get; set; } = "";

    private EventRecord? eventRecord;
    private InputFile? inputFileRef;
    private List<PhotoPreview> previews = new();
    private bool isUploading;
    private bool uploadComplete;
    private int uploadedCount;
    private int failedCount;
    private string? statusMessage;
    private string statusClass = "";

    private int photoLimit = 20;
    private string? sessionToken;
    private int previouslyUploaded = 0;
    private bool sessionLoaded = false;
    private bool eventFull = false;

    // This is the key calculation — accounts for previously uploaded AND currently selected photos
    private int remainingSlots => uploadComplete
    ? photoLimit - previouslyUploaded
    : photoLimit - previews.Count - previouslyUploaded;

    private int ProgressPercent => previews.Count == 0 ? 0 : (int)((uploadedCount + failedCount) * 100.0 / previews.Count);

    protected override void OnInitialized()
    {
        eventRecord = EventStorage.GetByToken(Token);

        if (eventRecord is not null)
        {
            photoLimit = eventRecord.PhotoLimit ?? 20;

            if (eventRecord.PhotoLimit.HasValue && eventRecord.PhotoCount >= eventRecord.PhotoLimit.Value)
                eventFull = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var existing = await JS.InvokeAsync<string>("eval",
                "document.cookie.split('; ').find(c => c.startsWith('pd_session='))?.split('=')[1] || ''");

            if (string.IsNullOrWhiteSpace(existing))
            {
                sessionToken = Guid.NewGuid().ToString("N")[..16];
                await JS.InvokeVoidAsync("eval",
                    $"document.cookie = 'pd_session={sessionToken}; path=/; max-age=86400; SameSite=Lax; Secure'");
            }
            else
            {
                sessionToken = existing;
            }

            // Check how many photos this guest has already uploaded
            try
            {
                var response = await Http.GetAsync($"/api/guest-uploads/{Token}?session={sessionToken}");
                if (response.IsSuccessStatusCode)
                {
                    var data = await response.Content.ReadFromJsonAsync<GuestUploadInfo>();
                    if (data is not null)
                        previouslyUploaded = data.PhotosUploaded;
                }
            }
            catch { }

            sessionLoaded = true;
            StateHasChanged();
        }
    }

    private async Task HandleFilesSelected(InputFileChangeEventArgs e)
    {
        statusMessage = null;
        statusClass = "";

        var files = e.GetMultipleFiles(maximumFileCount: 20);
        var element = inputFileRef?.Element;
        if (element is not null)
        {
            var jsResults = await JS.InvokeAsync<List<JsFilePreview>>("createPreviews", element);
            var newPhotos = jsResults.Select(r => new PhotoPreview
            {
                Index = r.Index,
                Name = r.Name,
                Size = r.Size,
                ContentType = r.Type,
                PreviewUrl = r.PreviewUrl,
                Status = ""
            }).ToList();

            // FIX: Account for previously uploaded photos when calculating available slots
            var slotsAvailable = photoLimit - previews.Count - previouslyUploaded;
            if (slotsAvailable <= 0)
            {
                statusMessage = $"You've reached the limit of {photoLimit} photos.";
                statusClass = "status-error";
                return;
            }

            if (newPhotos.Count > slotsAvailable)
            {
                statusMessage = $"Only {slotsAvailable} photo(s) allowed. Some were not added.";
                statusClass = "status-error";
                newPhotos = newPhotos.Take(slotsAvailable).ToList();
            }

            previews.AddRange(newPhotos);
        }
    }

    private void RemovePhoto(PhotoPreview photo)
    {
        previews.Remove(photo);
    }

    private async Task UploadFiles()
    {
        if (previews.Count == 0)
            return;

        isUploading = true;
        uploadComplete = false;
        uploadedCount = 0;
        failedCount = 0;
        statusMessage = null;
        statusClass = "";

        foreach (var photo in previews)
        {
            photo.Status = "uploading";
            StateHasChanged();

            try
            {
                var requestBody = new { fileName = photo.Name, contentType = photo.ContentType, sessionToken = sessionToken };
                var urlResponse = await Http.PostAsJsonAsync($"/api/upload-url/{Token}", requestBody);

                if (!urlResponse.IsSuccessStatusCode)
                {
                    photo.Status = "failed";
                    failedCount++;
                    StateHasChanged();
                    continue;
                }

                var urlResult = await urlResponse.Content.ReadFromJsonAsync<UploadUrlResponse>();
                if (urlResult is null || string.IsNullOrWhiteSpace(urlResult.UploadUrl))
                {
                    photo.Status = "failed";
                    failedCount++;
                    StateHasChanged();
                    continue;
                }

                var success = await JS.InvokeAsync<bool>("uploadFileByIndex", photo.Index, urlResult.UploadUrl);

                if (success)
                {
                    photo.Status = "done";
                    uploadedCount++;
                }
                else
                {
                    photo.Status = "failed";
                    failedCount++;
                }
            }
            catch
            {
                photo.Status = "failed";
                failedCount++;
            }

            StateHasChanged();
        }

        // Transfer from Cloud Storage to Google Drive
        if (uploadedCount > 0)
        {
            statusMessage = "Uploading...";
            StateHasChanged();

            try
            {
                var transferContent = new StringContent(
                    System.Text.Json.JsonSerializer.Serialize(new { sessionToken }),
                    System.Text.Encoding.UTF8, "application/json");
                var transferResponse = await Http.PostAsync($"/api/transfer/{Token}", transferContent);
                if (!transferResponse.IsSuccessStatusCode)
                {
                    statusMessage = "Transfer failed.";
                    statusClass = "status-error";
                }
                else
                {
                    statusMessage = null;
                }
            }
            catch
            {
                statusMessage = "Transfer failed.";
                statusClass = "status-error";
            }
        }

        // Clean up preview URLs
        var urls = previews.Select(p => p.PreviewUrl).Where(u => u != null).ToList();
        await JS.InvokeVoidAsync("revokePreviews", urls);

        // FIX: Update previouslyUploaded AFTER uploads complete
        previouslyUploaded += uploadedCount;
        isUploading = false;
        uploadComplete = true;
    }

    // FIX: Reset clears previews but keeps previouslyUploaded intact
    private void Reset()
    {
        previews.Clear();
        uploadComplete = false;
        uploadedCount = 0;
        failedCount = 0;
        statusMessage = null;
        statusClass = "";
    }

    private class PhotoPreview
    {
        public int Index { get; set; }
        public string Name { get; set; } = "";
        public long Size { get; set; }
        public string ContentType { get; set; } = "";
        public string? PreviewUrl { get; set; }
        public string Status { get; set; } = "";
    }

    private record JsFilePreview(int Index, string Name, long Size, string Type, string PreviewUrl);
    private record UploadUrlResponse(string UploadUrl, string ObjectName);
    private record GuestUploadInfo(int PhotosUploaded);
}