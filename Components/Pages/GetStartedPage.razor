@page "/get-started"
@inject NavigationManager Nav
@inject HttpClient Http
@inject PhotoDrop.Services.QrCodeService QrService
@inject PhotoDrop.Services.EventStorage EventStorage
@using Microsoft.AspNetCore.WebUtilities

<div class="get-started-page-container">
    <header class="get-started-header">
        <h1 class="get-started-title">Create Your Event</h1>
        <p class="get-started-subtitle">Name it first — then connect Drive.</p>
    </header>

    <section class="get-started-card">

        @* Step 1: Event name + connect *@
        @if (string.IsNullOrWhiteSpace(GuestToken))
        {
            <label class="field-label">Event Name</label>
            <input id="eventName"
                   class="text-input"
                   placeholder="Summer Party, Wedding"
                   @bind="EventName"
                   @bind:event="oninput" />
            <button class="btn-connect" disabled="@IsConnectDisabled" @onclick="ConnectDrive">
                Connect Google Drive
            </button>
            <p class="helper-text">We'll only upload photos to an event folder in your Drive</p>
        }

        @* Step 2: Storage info + guest limit *@
        else if (!settingsConfirmed)
        {
            <div class="storage-section">
                <p class="success-title">Google Drive connected!</p>

                @if (isLoadingStorage)
                {
                    <p class="storage-loading">Checking your Drive storage...</p>
                }
                else if (storageError is not null)
                {
                    <p class="storage-error">@storageError</p>
                    <button class="btn-connect" @onclick="ConfirmSettings">
                        Skip and continue
                    </button>
                }
                else
                {
                    <div class="storage-info">
                        <p class="storage-available">
                            You have <span class="storage-highlight">@availableFormatted</span> available on Google Drive
                        </p>
                        <p class="storage-note">
                            PhotoDrop will use up to half your available space to keep your other files safe.
                        </p>
                    </div>

                    <div class="guest-count-section">
                        <label class="field-label">How many guests do you expect?</label>
                        <input type="number"
                               class="text-input guest-count-input"
                               placeholder="e.g. 50"
                               min="1"
                               max="1000"
                               @bind="expectedGuests"
                               @bind:event="oninput" />
                    </div>

                    @if (expectedGuests > 0)
                    {
                        <div class="calculation-card">
                            <p class="calc-recommendation">
                                We recommend <span class="storage-highlight">@calculatedLimit</span> photos per guest
                            </p>
                            <p class="calc-detail">
                                @expectedGuests guests × @calculatedLimit photos = ~@totalPhotos photos (~@estimatedUsageFormatted)
                            </p>
                            <p class="calc-remaining">
                                You'll still have about <span class="storage-highlight">@remainingSpaceFormatted</span> free on your Drive
                            </p>

                            <div class="adjust-section">
                                <button class="btn-adjust" @onclick="ToggleAdjust">
                                    @(showAdjust ? "Hide" : "Adjust limit")
                                </button>

                                @if (showAdjust)
                                {
                                    <div class="adjust-control">
                                        <label class="adjust-label">Photos per guest:</label>
                                        <input type="number"
                                               class="text-input adjust-input"
                                               min="5"
                                               max="@maxPerGuest"
                                               @bind="guestPhotoLimit"
                                               @bind:event="oninput" />
                                    </div>

                                    @if (guestPhotoLimit != calculatedLimit)
                                    {
                                        <div class="adjust-preview">
                                            <p class="calc-detail">
                                                @expectedGuests guests × @guestPhotoLimit photos = ~@adjustedTotalPhotos photos (~@adjustedUsageFormatted)
                                            </p>
                                            <p class="calc-remaining">
                                                You'll still have about <span class="storage-highlight">@adjustedRemainingFormatted</span> free
                                            </p>
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                        <a href="https://one.google.com" target="_blank" class="storage-upgrade-link">
                            Need more space? Upgrade Google storage
                        </a>

                        <button class="btn-connect" @onclick="ConfirmSettings">
                            Confirm & get QR code
                        </button>
                    }
                }
            </div>
        }

        @* Step 3: QR code + share link *@
        else
        {
            <div class="success-card">
                <p class="success-title">Event created successfully!</p>
                <p class="success-text">Share this link or QR code with your guests:</p>
                <p class="success-detail">Each guest can upload up to @guestPhotoLimit photos</p>

                <div class="guest-link-box">
                    <input type="text" class="text-input" readonly value="@GuestLink" />
                </div>

                <div class="qr-section">
                    <img src="@QrDataUri" alt="QR Code for guest uploads" class="qr-image" />
                    <a href="/api/qr/@GuestToken" download class="btn-download">
                        Download QR Code
                    </a>
                </div>

                <button class="btn-edit" @onclick="EditSettings">
                    Edit settings
                </button>
            </div>
        }

    </section>
</div>

@code {
    private string EventName = "";
    private string? GuestToken;
    private string? QrDataUri;

    // Storage info
    private bool isLoadingStorage = true;
    private string? storageError;
    private string? availableFormatted;
    private long availableBytes;
    private long usableBytes; // 50% of available

    // Guest count and limits
    private int expectedGuests;
    private int guestPhotoLimit;
    private bool showAdjust;
    private bool settingsConfirmed;

    // Average photo size: 5 MB
    private const long AvgPhotoBytes = 5 * 1024 * 1024;

    // Calculated values based on guest count
    private int calculatedLimit => expectedGuests > 0
        ? Math.Max(5, (int)(usableBytes / AvgPhotoBytes / expectedGuests))
        : 0;

    private int totalPhotos => expectedGuests * calculatedLimit;
    private long totalUsageBytes => totalPhotos * AvgPhotoBytes;
    private string estimatedUsageFormatted => FormatBytes(totalUsageBytes);
    private string remainingSpaceFormatted => FormatBytes(availableBytes - totalUsageBytes);

    // Adjusted values when host manually changes the limit
    private int adjustedTotalPhotos => expectedGuests * guestPhotoLimit;
    private long adjustedUsageBytes => adjustedTotalPhotos * AvgPhotoBytes;
    private string adjustedUsageFormatted => FormatBytes(adjustedUsageBytes);
    private string adjustedRemainingFormatted => FormatBytes(availableBytes - adjustedUsageBytes);

    private int maxPerGuest => expectedGuests > 0
        ? Math.Max(5, (int)(usableBytes / AvgPhotoBytes / expectedGuests) * 2)
        : 50;

    private bool IsConnectDisabled =>
        string.IsNullOrWhiteSpace(EventName) || EventName.Trim().Length < 3;

    private string GuestLink => $"{Nav.BaseUri}e/{GuestToken}";

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("token", out var token))
        {
            GuestToken = token.ToString();
            QrDataUri = QrService.GenerateDataUri(GuestLink);
            await LoadStorageInfo();
        }
    }

    private async Task LoadStorageInfo()
    {
        isLoadingStorage = true;

        try
        {
            var response = await Http.GetAsync($"/api/storage/{GuestToken}");

            if (response.IsSuccessStatusCode)
            {
                var data = await response.Content.ReadFromJsonAsync<StorageResponse>();
                if (data is not null)
                {
                    availableFormatted = data.AvailableFormatted;
                    availableBytes = data.AvailableBytes;
                    usableBytes = availableBytes / 2; // Only use 50% of available space
                }
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                storageError = $"Couldn't check your Drive storage. You can still continue.";
            }
        }
        catch
        {
            storageError = "Couldn't check your Drive storage. You can still continue.";
        }

        isLoadingStorage = false;
    }

    private void ToggleAdjust()
    {
        showAdjust = !showAdjust;
        if (showAdjust)
            guestPhotoLimit = calculatedLimit;
    }

    private void ConfirmSettings()
    {
        // Use calculated limit unless host manually adjusted
        if (!showAdjust || guestPhotoLimit <= 0)
            guestPhotoLimit = calculatedLimit;

        if (!string.IsNullOrWhiteSpace(GuestToken))
        {
            var eventRecord = EventStorage.GetByToken(GuestToken);
            if (eventRecord is not null)
            {
                eventRecord.PhotoLimit = guestPhotoLimit;
                EventStorage.Update(eventRecord);
            }
        }

        settingsConfirmed = true;
    }

    private void EditSettings()
    {
        settingsConfirmed = false;
    }

    private void ConnectDrive()
    {
        var name = Uri.EscapeDataString(EventName.Trim());
        Nav.NavigateTo($"/auth/google/start?eventName={name}", forceLoad: true);
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "0 MB";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024L * 1024 * 1024) return $"{bytes / (1024.0 * 1024.0):F1} MB";
        return $"{bytes / (1024.0 * 1024.0 * 1024.0):F1} GB";
    }

    private record StorageResponse(string AvailableFormatted, string TotalFormatted, string UsedFormatted, int EstimatedPhotos, long AvailableBytes);
}