@page "/get-started"
@inject NavigationManager Nav
@inject PhotoDrop.Services.QrCodeService QrService
@using Microsoft.AspNetCore.WebUtilities

<div class="get-started-page-container">
    <header class="get-started-header">
        <h1 class="get-started-title">Create Your Event</h1>
        <p class="get-started-subtitle">Name it first — then connect Drive.</p>
    </header>

    <section class="get-started-card">
        <label class="field-label">Event Name</label>
        <input id="eventName"
                class="text-input"
                placeholder="Summer Party, Wedding"
                @bind="EventName"
                @bind:event="oninput"/>

        <button class="btn-connect" disabled="@IsConnectDisabled" @onclick="ConnectDrive">
            Connect Google Drive
        </button>

        <p class="helper-text">We'll only upload photos to an event folder in your Drive</p>

        @if (!string.IsNullOrWhiteSpace(GuestToken))
        {
            <div class="success-card">
                <p class="success-title"> Event created successfully!</p>
                <p class="success-text"> Share this link or QR code with your guests:</p>
                <div class="guest-link-box">
                    <input type="text" class="text-input" readonly value="@GuestLink"/>
                </div>

                <div class="qr-section">
                    <img  src="@QrDataUri" alt="QR Code for guest uploads" class="qr-image"/>
                    <a href="/api/qr/@GuestToken" download class="btn-download">
                        Download QR Code 
                    </a>
                </div>
            </div>
        }
    </section>
</div>

@code {
    private string EventName = "";

    private string? GuestToken;

    private string? QrDataUri;

    private bool IsConnectDisabled =>
        string.IsNullOrWhiteSpace(EventName) || EventName.Trim().Length < 3;

    private string GuestLink => $"{Nav.BaseUri}e/{GuestToken}";

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("token", out var token))
        {
            GuestToken = token.ToString();
            QrDataUri = QrService.GenerateDataUri(GuestLink);
        }
    }

    private void ConnectDrive()
    {
        var name = Uri.EscapeDataString(EventName.Trim());
        Nav.NavigateTo($"/auth/google/start?eventName={name}", forceLoad: true);
    }
}
